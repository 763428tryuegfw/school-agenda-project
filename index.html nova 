<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0E2C40">
<meta name="color-scheme" content="light">
<meta name="description" content="Agenda para anotar tarefas, entregas e provas, com calendário, rendimento, notas por matéria e avisos de prazo.">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Agenda">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<style>html{padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%}</style>
<title>Agenda Escolar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap">
<style>
/* Layout: fundo cinza escuro (descansa a vista), cartões um tom mais claros, abas em texto no computador e barra inferior com ícones no celular.
   Paleta: azul-marinho #0E2C40 (ação), azul #31708E, verde-água #148D8D (feito), limão #C1E1A7 (marca-texto),
   vermelho #C8102E, âmbar #EFBC75, cinzas #6B7280 e #E5E7EB.
   Prazo: vermelho até 3 dias, âmbar 4 a 6, azul 7 a 10. Hoje = contorno marinho. */
:root{
  color-scheme:light;
  --bg:#9CA3AA; --card:#B4BAC0; --raise:#C8CDD2; --ink:#111827; --navy:#0E2C40; --on-navy:#F2F6F8; --muted:#2B3340; --line:#8A929A; --soft:#A3AAB1;
  --blue:#31708E; --blue-ink:#153A4F; --blue-soft:#D3E5F1; --on-blue:#F6F9FA;
  --red:#C8102E; --red-ink:#8A0A1F; --red-soft:#F5DADF; --on-red:#F6F9FA;
  --yel:#5E3C00; --yel-soft:#F6E6C6; --yel-fill:#EFBC75; --on-yel:#2E1E00;
  --teal:#148D8D; --teal-ink:#084A4A; --lime:#C1E1A7; --lime-soft:#DBEACB; --sage:#34412F;
  --f-display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
  --f-body:'Instrument Sans','Segoe UI',system-ui,sans-serif;
  --f-mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 var(--f-body);padding-inline:16px;padding-block:24px 72px}
.wrap{max-width:1040px;margin-inline:auto;display:flex;flex-direction:column;gap:22px}
h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance;font-weight:600;color:var(--navy)}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.ic{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;display:block}

/* Cabeçalho */
.top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px}
.brand{display:flex;align-items:center;gap:14px;min-width:0}
.logo{width:46px;height:46px;border-radius:14px;background:var(--navy);color:var(--on-navy);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
h1{font-size:clamp(1.6rem,4.5vw,2.1rem);font-weight:700;line-height:1.05;letter-spacing:-.02em}
h1 mark{background:linear-gradient(transparent 58%,var(--lime) 58%);color:inherit;padding:0 .06em}
.hoje-txt{margin:4px 0 0;color:var(--muted);font-size:.9rem}
.status{font:500 .72rem var(--f-mono);color:var(--muted);display:inline-flex;align-items:center;gap:6px}
.status::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--teal)}
.status.warn::before{background:var(--yel-fill)}

/* Avisos */
.avisos{background:var(--card);border-radius:18px;padding:18px 20px;display:flex;flex-direction:column;gap:12px}
.av-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px 16px;flex-wrap:wrap}
.av-head h2{font-size:1.05rem}
.av-legend{display:flex;flex-wrap:wrap;gap:2px 14px;font-size:.78rem;color:var(--muted)}
.av-legend span,.legenda span{display:inline-flex;align-items:center;gap:6px}
.dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.dot.red{background:var(--red)}.dot.yel{background:var(--yel-fill)}.dot.blue{background:var(--blue)}.dot.far{background:var(--line);box-shadow:inset 0 0 0 1px #4B535B}
#avList{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.av{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;padding:11px 0;border-top:1px solid var(--line)}
.av:first-child{border-top:0}
.pill{font:500 .72rem var(--f-mono);padding:3px 10px;border-radius:999px;white-space:nowrap}
.pill.red{background:var(--red-soft);color:var(--red-ink)}
.pill.yel{background:var(--yel-soft);color:var(--yel)}
.pill.blue{background:var(--blue-soft);color:var(--blue-ink)}
.av-txt{flex:1 1 12rem;min-width:0;display:flex;flex-direction:column}
.av-txt strong{font-weight:600;overflow-wrap:anywhere;line-height:1.35}
.av-txt span{font-size:.82rem;color:var(--muted)}
.ghost{background:var(--raise);border:1px solid var(--line);border-radius:8px;padding:.25rem .75rem;font-size:.85rem;font-weight:500;color:var(--navy)}
.ghost:hover{background:var(--soft)}
.av-vazio{margin:0;color:var(--muted)}

/* Abas */
.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);display:flex;gap:26px;overflow-x:auto;border-bottom:1px solid var(--line);scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs button{flex:0 0 auto;background:none;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;padding:.75rem 0;color:var(--muted);font-weight:500;white-space:nowrap;display:flex;align-items:center}
.tabs button:hover{color:var(--navy)}
.tabs button[aria-selected="true"]{color:var(--navy);border-bottom-color:var(--navy)}
.ico{display:none}
.lbl .sh{display:none}
.count{font:500 .68rem var(--f-mono);background:var(--lime-soft);color:var(--teal-ink);padding:1px 7px;border-radius:999px;margin-left:6px}
.count[hidden]{display:none}
.panel[hidden]{display:none}
.panel{display:flex;flex-direction:column;gap:18px}
.ph{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px}
.ph h2{font-size:1.35rem;line-height:1.2}
.ph p{margin:2px 0 0;color:var(--muted);font-size:.9rem}
.nav{display:flex;gap:6px;flex-wrap:wrap}
.nav button{border:0;background:var(--card);border-radius:999px;padding:.4rem .95rem;font-size:.9rem;font-weight:500;color:var(--navy)}
.nav button:hover{background:var(--soft)}

/* Itens */
.itens{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.item{display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-top:1px solid var(--line);min-width:0}
.itens>.item:first-child{border-top:0;padding-top:0}
.item.feita .titulo{color:var(--muted);text-decoration:line-through}
.check{flex:0 0 auto;width:20px;height:20px;margin-top:2px;border:1.5px solid var(--sage);border-radius:50%;background:var(--raise);padding:0;position:relative}
.check:hover{border-color:var(--teal)}
.check[aria-checked="true"]{background:var(--teal);border-color:var(--teal)}
.check[aria-checked="true"]::after{content:"";position:absolute;left:5.5px;top:2px;width:5px;height:9px;border:solid var(--on-navy);border-width:0 2px 2px 0;transform:rotate(45deg)}
.txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.titulo{font-weight:600;overflow-wrap:anywhere;line-height:1.35}
.meta{font-size:.82rem;color:var(--muted);display:flex;flex-wrap:wrap;align-items:center;gap:2px 10px}
.obs{font-size:.82rem;color:var(--muted);overflow-wrap:anywhere}
.chip{font:500 .62rem var(--f-mono);text-transform:uppercase;letter-spacing:.07em;padding:2px 8px;border-radius:999px;background:var(--soft);color:var(--muted)}
.chip.prova{background:var(--navy);color:var(--on-navy)}
.chip.entrega{background:transparent;box-shadow:inset 0 0 0 1px var(--sage);color:var(--sage)}
.rel{font-weight:600}
.rel.red{color:var(--red-ink)}.rel.yel{color:var(--yel)}.rel.blue{color:var(--blue-ink)}.rel.far{color:var(--muted);font-weight:500}
.del{align-self:center;background:transparent;border:0;border-radius:8px;padding:.25rem .6rem;font-size:.8rem;color:var(--muted)}
.del:hover{background:var(--soft);color:var(--navy)}
.del.sure{background:var(--red);color:var(--on-red)}
.livre{margin:0;color:var(--muted);font-size:.85rem}
.vazio{background:var(--lime-soft);border-radius:18px;padding:22px 20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 16px}
.vazio[hidden]{display:none}
.vazio strong{font:600 1.1rem var(--f-display);display:block;color:var(--navy)}
.vazio span{color:var(--sage);font-size:.92rem}

/* Semana */
.semana{display:grid;grid-template-columns:1fr;gap:10px}
.dia{background:var(--card);border-radius:18px;padding:14px;display:grid;grid-template-columns:4.5rem 1fr;gap:10px;min-width:0}
.dia.hoje{background:var(--raise);box-shadow:inset 0 0 0 1.5px var(--navy)}
.dia-h{display:flex;flex-direction:column;align-items:flex-start;gap:4px}
.dow{font:500 .7rem var(--f-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.num{font:700 1.45rem/1 var(--f-display);color:var(--navy)}
.dia.hoje .num{background:var(--navy);color:var(--on-navy);padding:3px 8px;border-radius:8px}
.hojetag{font:500 .6rem var(--f-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.dia-b{display:flex;flex-direction:column;gap:8px;min-width:0}
.add{align-self:flex-start;background:none;border:0;padding:0;color:var(--muted);font-size:.82rem}
.add:hover{color:var(--blue-ink);text-decoration:underline}
@media (min-width:980px){
  .semana{grid-template-columns:repeat(7,minmax(0,1fr))}
  .dia{grid-template-columns:1fr}
  .dia-h{flex-direction:row;align-items:baseline;gap:8px}
}

/* Calendário */
.legenda{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:.8rem;color:var(--muted)}
.sq{width:10px;height:10px;border-radius:3px;background:var(--navy);display:inline-block}
.ring-h{width:12px;height:12px;border-radius:50%;box-shadow:inset 0 0 0 2px var(--navy);display:inline-block}
.duo{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:12px}
.card{background:var(--card);border-radius:18px;padding:18px 20px;display:flex;flex-direction:column;gap:12px;min-width:0}
.card h3{font-size:1.02rem}
.meses{display:grid;grid-template-columns:repeat(auto-fill,minmax(15.5rem,1fr));gap:12px}
.mes{background:var(--card);border-radius:18px;padding:14px;min-width:0}
.mes h3{font-size:.95rem;margin-bottom:8px;text-transform:capitalize}
.grade{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px;text-align:center}
.wd{font:500 .6rem var(--f-mono);color:var(--muted);padding-bottom:2px}
.d{aspect-ratio:1;border:0;border-radius:50%;background:transparent;padding:0;font-size:.76rem;font-variant-numeric:tabular-nums;color:var(--ink);display:flex;align-items:center;justify-content:center}
.d:hover{background:var(--soft)}
.d.u-red{background:var(--red);color:var(--on-red)}
.d.u-yel{background:var(--yel-fill);color:var(--on-yel)}
.d.u-blue{background:var(--blue);color:var(--on-blue)}
.d.u-far{background:var(--line);font-weight:600}
.d.prova{border-radius:5px}
.d.hoje{box-shadow:0 0 0 2px var(--card),0 0 0 4px var(--navy);font-weight:700}
.d.sel{outline:2px solid var(--blue);outline-offset:3px}

/* Rendimento */
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chips button{border:0;background:var(--card);border-radius:999px;padding:.4rem .95rem;font-size:.9rem;font-weight:500;color:var(--muted)}
.chips button[aria-pressed="true"]{background:var(--navy);color:var(--on-navy)}
.rend-top{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:12px}
.ringbox{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.ring{width:140px;height:140px;flex:0 0 auto}
.ring circle{fill:none;stroke-width:9}
.ring .bg{stroke:var(--raise)}
.ring .fg{stroke-linecap:round;transition:stroke-dashoffset .5s ease}
.ring text{fill:var(--navy);font:700 28px var(--f-display);text-anchor:middle}
.ring-msg{flex:1 1 10rem;min-width:0}
.ring-msg strong{font:600 1.1rem var(--f-display);display:block;color:var(--navy)}
.ring-msg p{margin:4px 0 0;color:var(--muted);font-size:.9rem}
.nums{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.nums div{background:var(--raise);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:2px}
.nums b{font:700 1.7rem/1 var(--f-display);color:var(--navy)}
.nums span{font-size:.78rem;color:var(--muted)}
.nums .l b{color:var(--red-ink)}
.nums .f b{color:var(--teal-ink)}
.bars{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}
.bar-top{display:flex;justify-content:space-between;gap:10px;font-size:.9rem;margin-bottom:5px}
.bar-top span:first-child{font-weight:600;overflow-wrap:anywhere}
.bar-top .mono{color:var(--muted);font-size:.76rem;white-space:nowrap}
.track{height:7px;background:var(--raise);border-radius:999px;overflow:hidden}
.fill{height:100%;background:var(--navy);border-radius:999px}

/* Formulário e listas */
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:16px}
.field{display:flex;flex-direction:column;gap:5px;min-width:0}
.field.full,.form .full{grid-column:1/-1}
.field label,.field legend{font-size:.8rem;font-weight:600;color:var(--muted)}
fieldset{border:0;margin:0;padding:0;min-width:0}
input[type=text],input[type=search],input[type=date],input[type=number],select,textarea{font:inherit;font-size:1rem;color:var(--ink);background:var(--raise);border:1px solid var(--line);border-radius:10px;padding:.65rem .8rem;min-width:0;width:100%}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg label{position:relative}
.seg input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.seg span{display:inline-block;background:var(--raise);box-shadow:inset 0 0 0 1px var(--line);border-radius:999px;padding:.45rem 1rem;font-weight:500;font-size:.95rem;color:var(--muted)}
.seg input:checked + span{background:var(--navy);box-shadow:none;color:var(--on-navy)}
.seg input:focus-visible + span{outline:2px solid var(--blue);outline-offset:2px}
textarea{resize:vertical;min-height:4.5rem}
.primary{background:var(--navy);color:var(--on-navy);border:0;border-radius:10px;padding:.75rem 1.5rem;font-weight:600}
.primary:hover{background:var(--blue)}
.erro{color:var(--red-ink);font-size:.85rem;margin:0}
.grp{font:500 .72rem var(--f-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--sage);margin:2px 0}
.busca{max-width:20rem}


select{cursor:pointer}
.dp{display:flex;flex-wrap:wrap;gap:6px}
.dp .c{background:var(--raise);border-radius:999px;padding:3px 11px;font-size:.85rem;color:var(--navy)}
.dp-sum{margin:6px 0 0;font-size:.82rem;color:var(--muted)}
.dp-sum.ok{color:var(--teal-ink);font-weight:600}
.dp-sum.warn{color:var(--yel);font-weight:600}

/* Matérias */
.mats{display:flex;flex-direction:column;gap:10px}
.mat{background:var(--card);border-radius:18px}
.mat>summary{list-style:none;cursor:pointer;padding:16px 20px;display:flex;align-items:center;gap:6px 14px;flex-wrap:wrap;border-radius:18px}
.mat>summary::-webkit-details-marker{display:none}
.mat>summary:hover{background:var(--soft)}
.mat[open]>summary{border-bottom-left-radius:0;border-bottom-right-radius:0}
.mat-n{flex:1 1 9rem;min-width:0;display:flex;flex-direction:column}
.mat-n strong{font:600 1.05rem var(--f-display);color:var(--navy);overflow-wrap:anywhere}
.mat-n span{font-size:.82rem;color:var(--muted)}
.mat-pts{font:700 1.15rem var(--f-display);color:var(--navy);font-variant-numeric:tabular-nums;white-space:nowrap}
.mat-pts small{font:500 .78rem var(--f-body);color:var(--muted)}
.mat-seta{width:9px;height:9px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg);margin:0 4px 4px 2px;flex:0 0 auto;transition:transform .2s}
.mat[open] .mat-seta{transform:rotate(-135deg);margin-bottom:-3px}
.mat-b{padding:4px 20px 20px;display:flex;flex-direction:column;gap:18px}
.sc{background:var(--raise);border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.sc-big{font:700 2.1rem/1 var(--f-display);color:var(--navy);font-variant-numeric:tabular-nums}
.sc-big small{font:500 .95rem var(--f-body);color:var(--muted)}
.sc-info{margin:0;font-size:.85rem;color:var(--muted)}
.comps{list-style:none;margin:0;padding:0}
.comp{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 12px;padding:10px 0;border-top:1px solid var(--line)}
.comp:first-child{border-top:0;padding-top:0}
.comp-t{display:flex;flex-direction:column;min-width:0}
.comp-n{font-weight:600;overflow-wrap:anywhere}
.comp-m{font-size:.8rem;color:var(--muted)}
.nota{display:flex;align-items:center;gap:6px;font-size:.85rem;color:var(--muted)}
.nota input{width:5.2rem;text-align:right;padding:.45rem .6rem}
.mat-act{display:flex;flex-wrap:wrap;gap:8px}
.ghost.sure{background:var(--red);border-color:var(--red);color:var(--on-red)}

.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--navy);color:var(--on-navy);padding:.6rem 1.1rem;border-radius:999px;font-size:.9rem;font-weight:500;max-width:calc(100vw - 32px);z-index:20;display:flex;align-items:center;gap:14px}
.toast[hidden]{display:none}
.toast button{background:none;border:0;padding:0;color:var(--lime);font-weight:600;text-decoration:underline;text-underline-offset:3px}
.toast button[hidden]{display:none}

/* Celular: barra inferior com ícones, como um aplicativo */
@media (max-width:719px){
  body{padding-block:20px calc(92px + env(safe-area-inset-bottom,0px))}
  .tabs{position:fixed;top:auto;left:0;right:0;bottom:0;gap:0;overflow:visible;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-bottom:0;border-top:1px solid var(--line);padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px))}
  .tabs button{flex-direction:column;justify-content:center;gap:2px;border:0;margin:0;padding:2px 0;font-size:.62rem;font-weight:500}
  .tabs button[aria-selected="true"]{border:0;font-weight:600}
  .ico{display:flex;padding:3px 12px;border-radius:999px}
  .tabs button[aria-selected="true"] .ico{background:var(--blue-soft)}
  .lbl .lg{display:none}
  .lbl .sh{display:inline}
  .tabs .count{display:none}
  .toast{bottom:calc(88px + env(safe-area-inset-bottom,0px))}
  .brand{gap:12px}
  .logo{width:42px;height:42px}
}
@media (prefers-reduced-motion:reduce){.ring .fg,.mat-seta{transition:none}}
</style>

</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand">
      <span class="logo" aria-hidden="true"><svg class="ic" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="3.5"/><path d="M3.5 10h17M8 3v4M16 3v4M9 15l2 2 4-4"/></svg></span>
      <div>
        <h1>Agenda <mark>Escolar</mark></h1>
        <p class="hoje-txt" id="hojeTxt"></p>
      </div>
    </div>
    <span class="status" id="status" role="status"></span>
  </header>

  <section class="avisos" aria-labelledby="avisosT" aria-live="polite">
    <div class="av-head">
      <h2 id="avisosT">Avisos <span class="count" id="av-count" hidden></span></h2>
      <div class="av-legend" aria-label="Legenda de cores">
        <span><i class="dot red"></i>até 3 dias</span>
        <span><i class="dot yel"></i>4 a 6 dias</span>
