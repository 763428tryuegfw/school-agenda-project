function fillComp(){
  const m=getMat(mkey($('#f-materia').value)),w=$('#fc-wrap'),sel=$('#f-comp'),cur=sel.value;
  if(!m||!m.comps.length){w.hidden=true;sel.innerHTML='<option value="">Nenhum</option>';return;}
